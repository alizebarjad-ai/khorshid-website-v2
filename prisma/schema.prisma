generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Announcement {
  id          String   @id @default(cuid())
  slug        String   @unique
  type        String   @default("اطلاعیه")
  title       String
  excerpt     String
  content     String[]
  dateLabel   String
  isoDate     DateTime
  image       String
  imageAlt    String
  important   Boolean  @default(false)
  showPopup   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, isoDate])
  @@index([important, showPopup, active])
}

model ParticipationRequest {
  id           String   @id @default(cuid())
  type         String
  name         String
  phone        String
  email        String
  city         String?
  artField     String?
  organization String?
  role         String?
  requestType  String?
  audience     String?
  subject      String?
  area         String?
  budget       String?
  message      String
  consent      Boolean  @default(false)
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([email])
}
